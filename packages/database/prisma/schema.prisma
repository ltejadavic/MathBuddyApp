generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  GUARDIAN
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         Role
  createdAt    DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  refreshTokenHash String?

  firstName String?
  lastName  String?
  timezone  String?
  country   String?

  studentProfile  StudentProfile?
  teacherProfile  TeacherProfile?
  guardianProfile GuardianProfile?

  verifiedPayments Payment[] @relation("PaymentVerifier")
  
  chatParticipants ChatParticipant[]
  chatMessages     ChatMessage[]

  @@map("users")
}

model StudentProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  school      String?
  gradeLevel  String?
  
  // Hours are stored as integer minutes
  remainingMinutes Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guardians        StudentGuardian[]
  enrollments      Enrollment[]
  attendances      ClassAttendance[]
  payments         Payment[]
  hourTransactions HourTransaction[]
  
  assignments      Assignment[]
  submissions      AssignmentSubmission[]
  assessmentResults AssessmentResult[]
  progressRecords  ProgressRecord[]
  classSummaries   ClassSummary[]

  @@map("student_profiles")
}

model TeacherProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  // Optional: rates and subjects can be added later
  bio String?
  
  hourlyRateCents Int    @default(0)
  currency        String @default("PEN")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses        TeacherCourse[]
  availabilities TeacherAvailability[]
  sessions       ClassSession[]
  earnings       TeacherEarning[]
  
  assignmentsCreated   Assignment[]
  submissionsGraded    AssignmentSubmission[] @relation("SubmissionGrader")
  assessmentsRecorded  AssessmentResult[]     @relation("AssessmentRecorder")
  progressUpdates      ProgressRecord[]
  classSummaries       ClassSummary[]

  @@map("teacher_profiles")
}

model GuardianProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  phoneNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students StudentGuardian[]
  payments Payment[]

  @@map("guardian_profiles")
}

model StudentGuardian {
  studentId        String
  guardianId       String
  student          StudentProfile  @relation(fields: [studentId], references: [id])
  guardian         GuardianProfile @relation(fields: [guardianId], references: [id])
  relationshipType String?
  isPrimaryBilling Boolean         @default(false)

  @@id([studentId, guardianId])
  @@map("student_guardians")
}

model Program {
  id          String   @id @default(uuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  courses     Course[]
  assessments Assessment[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("programs")
}

model Course {
  id          String   @id @default(uuid())
  programId   String
  program     Program  @relation(fields: [programId], references: [id])
  name        String
  description String?
  isActive    Boolean  @default(true)
  subjects    Subject[]
  
  teacherAssignments TeacherCourse[]
  enrollments        Enrollment[]
  sessions           ClassSession[]
  
  assignments        Assignment[]
  assessments        Assessment[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("courses")
}

model Subject {
  id          String   @id @default(uuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id])
  name        String
  description String?
  topics      Topic[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("subjects")
}

model Topic {
  id          String   @id @default(uuid())
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id])
  name        String
  description String?
  skills      Skill[]
  
  progressRecords ProgressRecord[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("topics")
}

model Skill {
  id          String   @id @default(uuid())
  topicId     String
  topic       Topic    @relation(fields: [topicId], references: [id])
  name        String
  description String?
  
  progressRecords ProgressRecord[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("skills")
}

model TeacherCourse {
  teacherId String
  courseId  String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id])
  course    Course         @relation(fields: [courseId], references: [id])
  createdAt DateTime       @default(now())

  @@id([teacherId, courseId])
  @@map("teacher_courses")
}

model Enrollment {
  id        String         @id @default(uuid())
  studentId String
  courseId  String
  student   StudentProfile @relation(fields: [studentId], references: [id])
  course    Course         @relation(fields: [courseId], references: [id])
  status    String         @default("ACTIVE")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([studentId, courseId])
  @@map("enrollments")
}

model TeacherAvailability {
  id        String         @id @default(uuid())
  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id])
  dayOfWeek Int
  startTime String
  endTime   String
  timeZone  String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("teacher_availabilities")
}

model ClassSession {
  id                 String   @id @default(uuid())
  courseId           String
  course             Course   @relation(fields: [courseId], references: [id])
  teacherId          String
  teacher            TeacherProfile @relation(fields: [teacherId], references: [id])
  
  scheduledStartTime DateTime
  scheduledEndTime   DateTime
  actualStartTime    DateTime?
  actualEndTime      DateTime?
  
  status             String   @default("SCHEDULED")
  meetingLink        String?
  notes              String?
  
  attendances        ClassAttendance[]
  hourTransactions   HourTransaction[]
  teacherEarning     TeacherEarning?
  classSummaries     ClassSummary[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("class_sessions")
}

model ClassAttendance {
  id             String         @id @default(uuid())
  classSessionId String
  classSession   ClassSession   @relation(fields: [classSessionId], references: [id])
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id])
  
  status         String         @default("EXPECTED")
  
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([classSessionId, studentId])
  @@map("class_attendances")
}

model Payment {
  id              String   @id @default(uuid())
  studentId       String
  student         StudentProfile @relation(fields: [studentId], references: [id])
  guardianId      String?
  guardian        GuardianProfile? @relation(fields: [guardianId], references: [id])
  
  amountCents     Int
  currency        String   @default("PEN")
  referenceNumber String?
  status          String   @default("PENDING")
  
  verifiedById    String?
  verifiedBy      User?    @relation(name: "PaymentVerifier", fields: [verifiedById], references: [id])
  
  packageMinutes  Int
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  hourTransactions HourTransaction[]

  @@map("payments")
}

model HourTransaction {
  id              String   @id @default(uuid())
  studentId       String
  student         StudentProfile @relation(fields: [studentId], references: [id])
  
  amountMinutes   Int
  type            String
  description     String?
  
  paymentId       String?
  payment         Payment? @relation(fields: [paymentId], references: [id])
  
  classSessionId  String?
  classSession    ClassSession? @relation(fields: [classSessionId], references: [id])

  createdAt       DateTime @default(now())

  @@map("hour_transactions")
}

model TeacherEarning {
  id              String   @id @default(uuid())
  teacherId       String
  teacher         TeacherProfile @relation(fields: [teacherId], references: [id])
  
  classSessionId  String   @unique
  classSession    ClassSession   @relation(fields: [classSessionId], references: [id])
  
  amountCents     Int
  currency        String   @default("PEN")
  status          String   @default("PENDING_PAYOUT") // PENDING_PAYOUT, PAID
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("teacher_earnings")
}

model ChatThread {
  id        String   @id @default(uuid())
  type      String   @default("DIRECT") // DIRECT, GROUP
  
  participants ChatParticipant[]
  messages     ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("chat_threads")
}

model ChatParticipant {
  id         String   @id @default(uuid())
  threadId   String
  thread     ChatThread @relation(fields: [threadId], references: [id])
  
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  
  lastReadAt DateTime?

  createdAt  DateTime @default(now())

  @@unique([threadId, userId])
  @@map("chat_participants")
}

model ChatMessage {
  id            String   @id @default(uuid())
  threadId      String
  thread        ChatThread @relation(fields: [threadId], references: [id])
  
  senderId      String
  sender        User       @relation(fields: [senderId], references: [id])
  
  content       String?
  attachmentUrl String?
  
  createdAt     DateTime @default(now())

  @@map("chat_messages")
}

model Assignment {
  id          String   @id @default(uuid())
  title       String
  description String?
  dueDate     DateTime?
  
  teacherId   String
  teacher     TeacherProfile @relation(fields: [teacherId], references: [id])
  
  courseId    String?
  course      Course?        @relation(fields: [courseId], references: [id])
  
  studentId   String?
  student     StudentProfile? @relation(fields: [studentId], references: [id])
  
  submissions AssignmentSubmission[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("assignments")
}

model AssignmentSubmission {
  id             String   @id @default(uuid())
  assignmentId   String
  assignment     Assignment @relation(fields: [assignmentId], references: [id])
  
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id])
  
  content        String?
  attachmentUrl  String?
  
  submittedAt    DateTime?
  status         String   @default("PENDING") // PENDING, SUBMITTED, GRADED
  
  rawScore       Float?
  scaledScore    Float?
  
  publicFeedback String?
  privateNotes   String?
  
  gradedById     String?
  gradedBy       TeacherProfile? @relation(name: "SubmissionGrader", fields: [gradedById], references: [id])
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([assignmentId, studentId])
  @@map("assignment_submissions")
}

model Assessment {
  id          String   @id @default(uuid())
  title       String
  description String?
  
  programId   String?
  program     Program? @relation(fields: [programId], references: [id])

  courseId    String?
  course      Course?  @relation(fields: [courseId], references: [id])
  
  totalRawScore Float?
  
  results     AssessmentResult[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("assessments")
}

model AssessmentResult {
  id             String   @id @default(uuid())
  assessmentId   String
  assessment     Assessment @relation(fields: [assessmentId], references: [id])
  
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id])
  
  dateTaken      DateTime
  
  rawScore       Float
  scaledScore    Float?
  
  publicFeedback String?
  privateNotes   String?
  
  recordedById   String
  recordedBy     TeacherProfile @relation(name: "AssessmentRecorder", fields: [recordedById], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("assessment_results")
}

model ProgressRecord {
  id          String   @id @default(uuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id])
  
  topicId     String?
  topic       Topic?   @relation(fields: [topicId], references: [id])
  
  skillId     String?
  skill       Skill?   @relation(fields: [skillId], references: [id])
  
  status      String   @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, MASTERED
  confidence  Int?     // 1 to 5 scale
  
  notes       String?
  
  updatedById String
  updatedBy   TeacherProfile @relation(fields: [updatedById], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([studentId, topicId, skillId])
  @@map("progress_records")
}

model ClassSummary {
  id             String   @id @default(uuid())
  classSessionId String
  classSession   ClassSession @relation(fields: [classSessionId], references: [id])
  
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id])
  
  teacherId      String
  teacher        TeacherProfile @relation(fields: [teacherId], references: [id])
  
  publicSummary  String? // Visible to guardian/student
  privateNotes   String? // Visible only to teachers/admins
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([classSessionId, studentId])
  @@map("class_summaries")
}
