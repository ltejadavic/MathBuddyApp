generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  GUARDIAN
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         Role
  createdAt    DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  refreshTokenHash String?

  firstName String?
  lastName  String?
  timezone  String?
  country   String?

  studentProfile  StudentProfile?
  teacherProfile  TeacherProfile?
  guardianProfile GuardianProfile?

  @@map("users")
}

model StudentProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  school      String?
  gradeLevel  String?
  
  // Hours are stored as integer minutes
  remainingMinutes Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guardians StudentGuardian[]

  @@map("student_profiles")
}

model TeacherProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  // Optional: rates and subjects can be added later
  bio String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("teacher_profiles")
}

model GuardianProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  phoneNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students StudentGuardian[]

  @@map("guardian_profiles")
}

model StudentGuardian {
  studentId        String
  guardianId       String
  student          StudentProfile  @relation(fields: [studentId], references: [id])
  guardian         GuardianProfile @relation(fields: [guardianId], references: [id])
  relationshipType String?
  isPrimaryBilling Boolean         @default(false)

  @@id([studentId, guardianId])
  @@map("student_guardians")
}
