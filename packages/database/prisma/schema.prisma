generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  GUARDIAN
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         Role
  createdAt    DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  refreshTokenHash String?

  firstName String?
  lastName  String?
  timezone  String?
  country   String?

  studentProfile  StudentProfile?
  teacherProfile  TeacherProfile?
  guardianProfile GuardianProfile?

  @@map("users")
}

model StudentProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  school      String?
  gradeLevel  String?
  
  // Hours are stored as integer minutes
  remainingMinutes Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guardians   StudentGuardian[]
  enrollments Enrollment[]

  @@map("student_profiles")
}

model TeacherProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  // Optional: rates and subjects can be added later
  bio String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses TeacherCourse[]

  @@map("teacher_profiles")
}

model GuardianProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  phoneNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students StudentGuardian[]

  @@map("guardian_profiles")
}

model StudentGuardian {
  studentId        String
  guardianId       String
  student          StudentProfile  @relation(fields: [studentId], references: [id])
  guardian         GuardianProfile @relation(fields: [guardianId], references: [id])
  relationshipType String?
  isPrimaryBilling Boolean         @default(false)

  @@id([studentId, guardianId])
  @@map("student_guardians")
}

model Program {
  id          String   @id @default(uuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  courses     Course[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("programs")
}

model Course {
  id          String   @id @default(uuid())
  programId   String
  program     Program  @relation(fields: [programId], references: [id])
  name        String
  description String?
  isActive    Boolean  @default(true)
  subjects    Subject[]
  
  teacherAssignments TeacherCourse[]
  enrollments        Enrollment[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("courses")
}

model Subject {
  id          String   @id @default(uuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id])
  name        String
  description String?
  topics      Topic[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("subjects")
}

model Topic {
  id          String   @id @default(uuid())
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id])
  name        String
  description String?
  skills      Skill[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("topics")
}

model Skill {
  id          String   @id @default(uuid())
  topicId     String
  topic       Topic    @relation(fields: [topicId], references: [id])
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("skills")
}

model TeacherCourse {
  teacherId String
  courseId  String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id])
  course    Course         @relation(fields: [courseId], references: [id])
  createdAt DateTime       @default(now())

  @@id([teacherId, courseId])
  @@map("teacher_courses")
}

model Enrollment {
  id        String         @id @default(uuid())
  studentId String
  courseId  String
  student   StudentProfile @relation(fields: [studentId], references: [id])
  course    Course         @relation(fields: [courseId], references: [id])
  status    String         @default("ACTIVE")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([studentId, courseId])
  @@map("enrollments")
}
