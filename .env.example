# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=mathbuddy

# NestJS API Configuration
NODE_ENV=production
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public

# Authentication Secrets
# Generate random 32+ character strings for these
JWT_SECRET=super_secret_jwt_key_replace_me
JWT_REFRESH_SECRET=super_secret_refresh_key_replace_me

# Next.js Web Configuration
FRONTEND_URL=https://your-domain.com
NEXT_PUBLIC_API_URL=https://api.your-domain.com

# SMTP Configuration (For Email Notifications)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
